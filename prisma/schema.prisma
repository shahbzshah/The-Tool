generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Project {
  id           String         @id @default(cuid())
  name         String
  category     String
  preferences  String?
  stackLock    String? // canonical tech stack — injected into all doc generation
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  ideas        Idea[]
  stitchPrompt StitchPrompt?
  uploads      Upload[]
}

model Idea {
  id             String        @id @default(cuid())
  projectId      String
  project        Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title          String
  pitch          String
  features       String // JSON array of strings
  targetAudience String
  monetization   String?
  scores         String? // JSON: { novelty, feasibility, marketDemand }
  validation     String? // JSON red-team report (see /api/ideas/[id]/validate)
  favorite       Boolean       @default(false)
  status         String        @default("draft") // draft | approved
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  documents      Document[]

  @@index([projectId])
}

model StitchPrompt {
  id          String   @id @default(cuid())
  projectId   String   @unique
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  promptText  String
  appType     String
  screens     String // JSON array
  colorScheme String
  style       String
  components  String // JSON array
  platform    String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Upload {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  type      String // design_md | html | screenshot
  filename  String
  path      String
  content   String? // extracted text for design_md / html
  createdAt DateTime @default(now())

  @@index([projectId])
}

model Document {
  id        String   @id @default(cuid())
  ideaId    String
  idea      Idea     @relation(fields: [ideaId], references: [id], onDelete: Cascade)
  kind      String // PRD | BRD | TECHNICAL_SPEC | USER_STORIES | WORKFLOW | DATABASE_SCHEMA | API_SPEC | DESIGN_SYSTEM | FOLDER_STRUCTURE | RULES | MASTER_PROMPT
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([ideaId, kind])
}
