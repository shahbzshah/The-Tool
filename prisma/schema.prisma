generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  name         String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  scanJobs     ScanJob[]
}

model RefineMessage {
  id        String   @id @default(cuid())
  projectId String
  ideaId    String
  role      String // user | assistant
  content   String
  createdAt DateTime @default(now())

  @@index([projectId, ideaId, createdAt])
}

model Project {
  id           String         @id @default(cuid())
  name         String
  category     String
  platform     String? // "mobile" (Android + iOS, web optional) | "web" | null (AI decides)
  preferences  String?
  stackLock    String? // canonical tech stack — injected into all doc generation
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  ideas        Idea[]
  stitchPrompt StitchPrompt?
  uploads      Upload[]
}

model Idea {
  id             String        @id @default(cuid())
  projectId      String
  project        Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title          String
  pitch          String
  features       String // JSON array of strings
  targetAudience String
  monetization   String?
  scores         String? // JSON: { novelty, feasibility, marketDemand }
  validation     String? // JSON red-team report (see /api/ideas/[id]/validate)
  favorite       Boolean       @default(false)
  status         String        @default("draft") // draft | approved
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  documents      Document[]

  @@index([projectId])
}

model StitchPrompt {
  id          String   @id @default(cuid())
  projectId   String   @unique
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  promptText  String
  appType     String
  screens     String // JSON array
  colorScheme String
  style       String
  components  String // JSON array
  platform    String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Upload {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  type      String // design_md | html | screenshot
  filename  String
  path      String
  content   String? // extracted text for design_md / html
  createdAt DateTime @default(now())

  @@index([projectId])
}

model Document {
  id        String   @id @default(cuid())
  ideaId    String
  idea      Idea     @relation(fields: [ideaId], references: [id], onDelete: Cascade)
  kind      String // PRD | BRD | TECHNICAL_SPEC | USER_STORIES | WORKFLOW | DATABASE_SCHEMA | API_SPEC | DESIGN_SYSTEM | FOLDER_STRUCTURE | RULES | MASTER_PROMPT | BUILD_GUIDE
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([ideaId, kind])
}

// ---- Opportunity Hunter models (merged) ----

model ScanJob {
  id           String        @id @default(cuid())
  keyword      String
  status       String        @default("pending") // pending | running | completed | failed
  resultsCount Int           @default(0)
  error        String?
  userId       String?
  user         User?         @relation(fields: [userId], references: [id], onDelete: Cascade)
  startedAt    DateTime?
  finishedAt   DateTime?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  opportunities Opportunity[]

  @@index([status])
  @@index([userId])
}

model Opportunity {
  id           String   @id @default(cuid())
  scanJobId    String?
  scanJob      ScanJob? @relation(fields: [scanJobId], references: [id], onDelete: Cascade)
  appId        String
  title        String
  developer    String?
  iconUrl      String?
  rating       Float?
  installs     String?
  installsMin  BigInt?
  reviewsCount BigInt?
  score        Float    @default(0)
  category     String?
  summary      String?
  url          String?
  isBookmarked Boolean  @default(false)
  breakdown    String? // JSON: { quality, gap, market, competition }
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  analyses     OpportunityAnalysis[]

  @@index([appId])
  @@index([scanJobId])
}

model OpportunityAnalysis {
  id            String      @id @default(cuid())
  opportunityId String?
  opportunity   Opportunity? @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  appId         String
  provider      String      @default("nvidia")
  content       String // JSON: full AI analysis shape
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([appId])
}

model TrendIdea {
  id        String   @id @default(cuid())
  title     String
  source    String // Hacker News | Reddit | Lobsters
  hotness   Int      @default(0)
  url       String?
  text      String?
  analysis  String? // JSON: cached AI deep-dive
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([source])
}
