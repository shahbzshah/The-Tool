generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  name         String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  scanJobs     ScanJob[]
  intakeJobs   IntakeJob[]
  scoreHistories OpportunityScoreHistory[]
  projects     Project[]
  isAdmin      Boolean   @default(false)
  resetTokens  PasswordResetToken[]
}

model RefineMessage {
  id        String   @id @default(cuid())
  projectId String
  ideaId    String
  role      String // user | assistant
  content   String
  createdAt DateTime @default(now())
  userId    String?

  @@index([projectId, ideaId, createdAt])
}

model Project {
  id           String         @id @default(cuid())
  name         String
  category     String
  platform     String? // "mobile" (Android + iOS, web optional) | "web" | null (AI decides)
  preferences  String?
  stackLock    String? // canonical tech stack — injected into all doc generation
  techDecisions String? // JSON object of locked technical decisions {database, frontend, backend, auth, speech, sync, hosting} — injected into all doc generation; one decision, propagated everywhere
  status       String         @default("refine") // hunter | refine | design | docs | export — current pipeline stage
  archivedAt   DateTime?      // set when the project is archived
  notes        String?        @db.Text
  decisions    String?        // JSON array of applied refine decisions — persists the decisions log
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  ideas        Idea[]
  shareTokens  ShareToken[]
  stitchPrompt StitchPrompt?
  uploads      Upload[]
  userId       String?
  user         User?   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Idea {
  id             String        @id @default(cuid())
  projectId      String
  project        Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title          String
  pitch          String
  features       String // JSON array of strings
  targetAudience String
  monetization   String?
  scores         String? // JSON: { novelty, feasibility, marketDemand }
  validation     String? // JSON red-team report (see /api/ideas/[id]/validate)
  favorite       Boolean       @default(false)
  status         String        @default("draft") // draft | approved
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  documents      Document[]
  versions       IdeaVersion[]

  @@index([projectId])
}

model StitchPrompt {
  id          String   @id @default(cuid())
  projectId   String   @unique
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  promptText  String
  appType     String
  screens     String // JSON array
  colorScheme String
  style       String
  components  String // JSON array
  platform    String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Upload {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  type      String // design_md | html | screenshot
  filename  String
  path      String
  batchId   String? // groups uploads from one design import (another worker manages this)
  content   String? // extracted text for design_md / html
  createdAt DateTime @default(now())

  @@index([projectId])
}

model Document {
  id        String   @id @default(cuid())
  ideaId    String
  idea      Idea     @relation(fields: [ideaId], references: [id], onDelete: Cascade)
  kind      String // PRD | BRD | TECHNICAL_SPEC | USER_STORIES | WORKFLOW | DATABASE_SCHEMA | API_SPEC | DESIGN_SYSTEM | FOLDER_STRUCTURE | RULES | MASTER_PROMPT | BUILD_GUIDE
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  versions  DocumentVersion[]

  @@unique([ideaId, kind])
}

model DocumentVersion {
  id         String   @id @default(cuid())
  documentId String
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  version    Int      // 1-based, increments per document
  content    String   @db.Text
  createdAt  DateTime @default(now())

  @@index([documentId, version])
}

model AiUsage {
  id        String   @id @default(cuid())
  userId    String
  projectId String?
  kind      String   // docgen | refine
  tokensIn  Int      @default(0)
  tokensOut Int      @default(0)
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([projectId])
}

// ---- Opportunity Hunter models (merged) ----

model ScanJob {
  id           String        @id @default(cuid())
  keyword      String
  status       String        @default("pending") // pending | running | completed | failed
  resultsCount Int           @default(0)
  error        String?
  userId       String?
  user         User?         @relation(fields: [userId], references: [id], onDelete: Cascade)
  startedAt    DateTime?
  finishedAt   DateTime?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  opportunities Opportunity[]
  scoreHistories OpportunityScoreHistory[]

  @@index([status])
  @@index([userId])
}

model Opportunity {
  id           String   @id @default(cuid())
  scanJobId    String?
  scanJob      ScanJob? @relation(fields: [scanJobId], references: [id], onDelete: Cascade)
  appId        String
  title        String
  developer    String?
  iconUrl      String?
  rating       Float?
  installs     String?
  installsMin  BigInt?
  reviewsCount BigInt?
  score        Float    @default(0)
  category     String?
  summary      String?
  url          String?
  isBookmarked Boolean  @default(false)
  breakdown    String? // JSON: { quality, gap, market, competition }
  // Intake front door (Phases 0-2): Hunter rows keep "hunter". Rows made
  // from an upload, a pasted link, or a typed idea carry their source here,
  // plus the thumbnail (uploaded image / video contact sheet / app icon)
  // shown beside the score so the idea record stays self-explanatory.
  source       String  @default("hunter") // hunter | upload | link | own-idea
  thumbnail    String? @db.Text // data URL, small (downscaled image / contact sheet)
  // Power & Accuracy plan fields (stored at scan time from Play payload +
  // snapshot history; recomputed on every scan):
  offersIap      Boolean? // Play offersIAP flag
  containsAds    Boolean? // Play adSupported flag
  priceText      String?  // e.g. "Free", "$2.99"
  playUpdated    String?  // Play last-update date as returned by the scraper
  velocityPerDay Float?   // new ratings/day from snapshot history (null = collecting history)
  deltaRatings30 Int?     // ratings-count change over the last ~30 days
  isRising       Boolean  @default(false) // young + accelerating (see lib/hunter/composite)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  analyses     OpportunityAnalysis[]
  evidence     NicheEvidence?

  @@index([appId])
  @@index([scanJobId])
  // NOTE: @@unique([scanJobId, appId]) removed — it broke Vercel deploys
  // (db push fails on pre-existing duplicates). Dedupe is enforced in
  // application code (scan + watchlist routes) instead.
}

model IntakeJob {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  source        String // upload | link | own-idea
  status        String   @default("awaiting_confirm") // queued | preparing | understanding | awaiting_confirm | researching | done | failed
  originalName  String?
  mimeType      String?
  sizeBytes     Int?
  linkUrl       String?
  caption       String?  @db.Text
  // Derived media only — the uploaded file itself is never stored. For an
  // image: the downscaled image. For video: contact sheet + sharpest
  // frames. Purged (set null) when research completes; the thumbnail then
  // lives on the Opportunity row only.
  mediaJson     String?  @db.Text // { thumbnail: string, frames: string[] }
  draftJson     String   @db.Text // validated §5 draft (see lib/hunter/understanding)
  opportunityId String?
  scanJobId     String?
  error         String?  @db.Text // plain-language failure, if any
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([userId])
  @@index([status])
}

// ---- Power & Accuracy plan models ----
//
// One row per app per UTC day. The snapshot store is the foundation of
// every time-based signal in the plan: rating velocity, acceleration,
// install-bracket crossings, first-seen age, and category-rank moves.
// Written by every hunter scan and every watchlist scan (upsert on
// [appId, day] so repeated scans on one day don't duplicate rows).
model AppSnapshot {
  id           String   @id @default(cuid())
  appId        String
  day          String   // YYYY-MM-DD (UTC)
  ratingsCount BigInt?
  score        Float?
  installs     String?
  installsMin  BigInt?
  playUpdated  String?
  categoryRank Int?     // position in its category top-free chart, when seen
  keyword      String?  // scan keyword that produced this snapshot
  createdAt    DateTime @default(now())

  @@unique([appId, day])
  @@index([appId, day])
}

// Cached computed evidence packet for one opportunity (wedge audit,
// velocity, review themes with code-verified quotes, monetisation strip,
// freshness, trend slope, range estimate). Recomputed at most every 7
// days, or on forced re-analysis. The LLM scorecard is built ONLY from
// this packet — never from raw metadata.
model NicheEvidence {
  id            String      @id @default(cuid())
  opportunityId String      @unique
  opportunity   Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  packet        String      @db.Text // JSON evidence packet (see lib/hunter/evidence)
  computedAt    DateTime    @default(now())

  @@index([opportunityId])
}

model OpportunityAnalysis {
  id            String      @id @default(cuid())
  opportunityId String?
  opportunity   Opportunity? @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  appId         String
  provider      String      @default("nvidia")
  content       String // JSON: full AI analysis shape
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([appId])
}

model TrendIdea {
  id        String   @id @default(cuid())
  title     String
  source    String // Hacker News | Reddit | Lobsters
  hotness   Int      @default(0)
  url       String?
  text      String?
  analysis  String? // JSON: cached AI deep-dive
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([source])
}

model AppSetting {
  key       String   @id // e.g. NVIDIA_API_KEY, NVIDIA_MODEL, CRON_SECRET
  value     String   // AES-256-GCM encrypted, base64
  updatedAt DateTime @updatedAt
}

// ---- Audit / history / share models (migration: add_audit_models) ----

model OpportunityScoreHistory {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  appId     String
  score     Float
  scanJobId String?
  scanJob   ScanJob? @relation(fields: [scanJobId], references: [id], onDelete: SetNull)
  scannedAt DateTime @default(now())

  @@index([userId, appId])
  @@index([appId])
}

model IdeaVersion {
  id             String   @id @default(cuid())
  ideaId         String
  idea           Idea     @relation(fields: [ideaId], references: [id], onDelete: Cascade)
  title          String
  pitch          String
  features       String   // JSON array of strings (snapshot before change)
  targetAudience String
  monetization   String?
  note           String?  // e.g. "before AI update: added X"
  createdAt      DateTime @default(now())

  @@index([ideaId])
}

model ShareToken {
  id        String    @id @default(cuid())
  token     String    @unique @default(cuid())
  projectId String?
  project   Project?  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  ideaId    String?
  createdAt DateTime  @default(now())
  expiresAt DateTime?

  @@index([token])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  token     String   @unique @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  @@index([token])
  @@index([userId])
}
