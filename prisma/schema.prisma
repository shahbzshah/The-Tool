generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  name         String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  scanJobs     ScanJob[]
  scoreHistories OpportunityScoreHistory[]
  projects     Project[]
  isAdmin      Boolean   @default(false)
}

model RefineMessage {
  id        String   @id @default(cuid())
  projectId String
  ideaId    String
  role      String // user | assistant
  content   String
  createdAt DateTime @default(now())
  userId    String?

  @@index([projectId, ideaId, createdAt])
}

model Project {
  id           String         @id @default(cuid())
  name         String
  category     String
  platform     String? // "mobile" (Android + iOS, web optional) | "web" | null (AI decides)
  preferences  String?
  stackLock    String? // canonical tech stack — injected into all doc generation
  status       String         @default("refine") // hunter | refine | design | docs | export — current pipeline stage
  archivedAt   DateTime?      // set when the project is archived
  notes        String?        @db.Text
  decisions    String?        // JSON array of applied refine decisions — persists the decisions log
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  ideas        Idea[]
  shareTokens  ShareToken[]
  stitchPrompt StitchPrompt?
  uploads      Upload[]
  userId       String?
  user         User?   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Idea {
  id             String        @id @default(cuid())
  projectId      String
  project        Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title          String
  pitch          String
  features       String // JSON array of strings
  targetAudience String
  monetization   String?
  scores         String? // JSON: { novelty, feasibility, marketDemand }
  validation     String? // JSON red-team report (see /api/ideas/[id]/validate)
  favorite       Boolean       @default(false)
  status         String        @default("draft") // draft | approved
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  documents      Document[]
  versions       IdeaVersion[]

  @@index([projectId])
}

model StitchPrompt {
  id          String   @id @default(cuid())
  projectId   String   @unique
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  promptText  String
  appType     String
  screens     String // JSON array
  colorScheme String
  style       String
  components  String // JSON array
  platform    String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Upload {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  type      String // design_md | html | screenshot
  filename  String
  path      String
  batchId   String? // groups uploads from one design import (another worker manages this)
  content   String? // extracted text for design_md / html
  createdAt DateTime @default(now())

  @@index([projectId])
}

model Document {
  id        String   @id @default(cuid())
  ideaId    String
  idea      Idea     @relation(fields: [ideaId], references: [id], onDelete: Cascade)
  kind      String // PRD | BRD | TECHNICAL_SPEC | USER_STORIES | WORKFLOW | DATABASE_SCHEMA | API_SPEC | DESIGN_SYSTEM | FOLDER_STRUCTURE | RULES | MASTER_PROMPT | BUILD_GUIDE
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  versions  DocumentVersion[]

  @@unique([ideaId, kind])
}

model DocumentVersion {
  id         String   @id @default(cuid())
  documentId String
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  version    Int      // 1-based, increments per document
  content    String   @db.Text
  createdAt  DateTime @default(now())

  @@index([documentId, version])
}

model AiUsage {
  id        String   @id @default(cuid())
  userId    String
  projectId String?
  kind      String   // docgen | refine
  tokensIn  Int      @default(0)
  tokensOut Int      @default(0)
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([projectId])
}

// ---- Opportunity Hunter models (merged) ----

model ScanJob {
  id           String        @id @default(cuid())
  keyword      String
  status       String        @default("pending") // pending | running | completed | failed
  resultsCount Int           @default(0)
  error        String?
  userId       String?
  user         User?         @relation(fields: [userId], references: [id], onDelete: Cascade)
  startedAt    DateTime?
  finishedAt   DateTime?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  opportunities Opportunity[]
  scoreHistories OpportunityScoreHistory[]

  @@index([status])
  @@index([userId])
}

model Opportunity {
  id           String   @id @default(cuid())
  scanJobId    String?
  scanJob      ScanJob? @relation(fields: [scanJobId], references: [id], onDelete: Cascade)
  appId        String
  title        String
  developer    String?
  iconUrl      String?
  rating       Float?
  installs     String?
  installsMin  BigInt?
  reviewsCount BigInt?
  score        Float    @default(0)
  category     String?
  summary      String?
  url          String?
  isBookmarked Boolean  @default(false)
  breakdown    String? // JSON: { quality, gap, market, competition }
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  analyses     OpportunityAnalysis[]

  @@index([appId])
  @@index([scanJobId])
  // NOTE: @@unique([scanJobId, appId]) removed — it broke Vercel deploys
  // (db push fails on pre-existing duplicates). Dedupe is enforced in
  // application code (scan + watchlist routes) instead.
}

model OpportunityAnalysis {
  id            String      @id @default(cuid())
  opportunityId String?
  opportunity   Opportunity? @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  appId         String
  provider      String      @default("nvidia")
  content       String // JSON: full AI analysis shape
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([appId])
}

model TrendIdea {
  id        String   @id @default(cuid())
  title     String
  source    String // Hacker News | Reddit | Lobsters
  hotness   Int      @default(0)
  url       String?
  text      String?
  analysis  String? // JSON: cached AI deep-dive
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([source])
}

model AppSetting {
  key       String   @id // e.g. NVIDIA_API_KEY, NVIDIA_MODEL, CRON_SECRET
  value     String   // AES-256-GCM encrypted, base64
  updatedAt DateTime @updatedAt
}

// ---- Audit / history / share models (migration: add_audit_models) ----

model OpportunityScoreHistory {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  appId     String
  score     Float
  scanJobId String?
  scanJob   ScanJob? @relation(fields: [scanJobId], references: [id], onDelete: SetNull)
  scannedAt DateTime @default(now())

  @@index([userId, appId])
  @@index([appId])
}

model IdeaVersion {
  id             String   @id @default(cuid())
  ideaId         String
  idea           Idea     @relation(fields: [ideaId], references: [id], onDelete: Cascade)
  title          String
  pitch          String
  features       String   // JSON array of strings (snapshot before change)
  targetAudience String
  monetization   String?
  note           String?  // e.g. "before AI update: added X"
  createdAt      DateTime @default(now())

  @@index([ideaId])
}

model ShareToken {
  id        String    @id @default(cuid())
  token     String    @unique @default(cuid())
  projectId String?
  project   Project?  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  ideaId    String?
  createdAt DateTime  @default(now())
  expiresAt DateTime?

  @@index([token])
}
