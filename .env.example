# ============================================================
# The-Tool — environment variables
# Copy to .env and fill in. Env vars always take precedence
# over the same values saved in the Settings page (/settings),
# which are AES-256-GCM encrypted in the database instead.
# ============================================================

# ---- REQUIRED ----
# Neon Postgres connection string (Prisma datasource).
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# ---- AI (NVIDIA Build) ----
# REQUIRED for all AI features: idea analysis, Refine chat, doc generation.
# Also settable via /settings (encrypted in DB); env wins when set.
# Get a key at build.nvidia.com.
NVIDIA_API_KEY=

# ---- OPTIONAL ----
# NVIDIA model override. Default: meta/llama-3.2-11b-vision-instruct
NVIDIA_MODEL=

# Root secret used to encrypt Settings-page values in the DB.
# If unset, a random secret is generated once and stored in the DB —
# set this explicitly on hosted deployments so encrypted settings
# survive database resets/redeploys.
AUTH_SECRET=

# App owner email. Gets full admin access. Default: admin@gmail.com
ADMIN_EMAIL=

# Daily watchlist cron auth — Ed25519 public key (PEM, multiline OK).
# The cron job signs requests with the matching private key; paste the
# public key here or in /settings instead of a shared secret.
CRON_PUBLIC_KEY=

# Legacy cron bearer token (superseded by CRON_PUBLIC_KEY above).
# Resolved from the encrypted DB setting "CRON_SECRET"; kept for
# backwards compatibility with older cron setups.
CRON_SECRET=
