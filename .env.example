# Database — Neon Postgres connection string (production) or local Postgres
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# AI — Poolside (OpenAI-compatible), used for docs generation
POOLSIDE_API_KEY=
POOLSIDE_MODEL=poolside/laguna-s-2.1
POOLSIDE_BASE_URL=https://inference.poolside.ai/v1

# AI — NVIDIA (preferred for Hunter idea analysis, OpenAI-compatible)
NVIDIA_API_KEY=
NVIDIA_MODEL=meta/llama-3.2-11b-vision-instruct
